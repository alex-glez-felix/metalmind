# Maintainer: Alejandro Gonzalez <alex.glez.felix at gmail dot com>

# Instala el binario del GitHub Release. Al publicar una versión, pkgver y las
# sumas se actualizan como dice docs/release.md.
pkgname=metalmind-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Editor de notas markdown con modo vim, nativo para Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/alex-glez-felix/metalmind'
license=('GPL-3.0-or-later' 'MIT')
# ttf-dejavu: Metalmind no abre sin una monoespaciada de su lista (metalmind-ui/src/theme.rs).
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'ttf-dejavu' 'vulkan-icd-loader' 'wayland')
optdepends=('ttf-jetbrains-mono: la fuente monoespaciada preferida'
            'xdg-desktop-portal-impl: el selector de carpetas para elegir el vault la primera vez')
provides=('metalmind')
conflicts=('metalmind')
source_x86_64=("$url/releases/download/v$pkgver/metalmind-x86_64-unknown-linux-gnu.tar.xz")
source_aarch64=("$url/releases/download/v$pkgver/metalmind-aarch64-unknown-linux-gnu.tar.xz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "metalmind-$CARCH-unknown-linux-gnu"
  install -Dm755 metalmind -t "$pkgdir/usr/bin"
  install -Dm644 metalmind.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 metalmind.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 io.github.alex_glez_felix.metalmind.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/metalmind"
  install -Dm644 tabler.LICENSE "$pkgdir/usr/share/licenses/$pkgname/tabler-icons.LICENSE"
}
