# Maintainer: Alejandro Gonzalez <alex.glez.felix at gmail dot com>

# Compila la rama main del repo.
pkgname=nota-git
pkgver=0.0.0.r0.g0000000
pkgrel=1
pkgdesc='Editor de notas markdown con modo vim, nativo para Linux (rama main)'
arch=('x86_64' 'aarch64')
url='https://github.com/alex-glez-felix/nota'
license=('GPL-3.0-or-later')
# ttf-dejavu: nota no abre sin una monoespaciada de su lista (nota-ui/src/theme.rs).
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'ttf-dejavu' 'vulkan-icd-loader' 'wayland')
# fontconfig: yeslogic-fontconfig-sys lo busca con pkg-config al compilar.
makedepends=('cargo' 'fontconfig' 'git')
optdepends=('ttf-jetbrains-mono: la fuente monoespaciada preferida')
provides=('nota')
conflicts=('nota')
source=("nota::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd nota
  local described
  if described=$(git describe --long --tags --abbrev=7 --match 'v*' 2>/dev/null); then
    printf '%s' "$described" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    # Antes del primer tag se cuenta desde 0.0.0.
    printf '0.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd nota
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd nota
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p nota
}

# Sin check(): la suite completa recompila todo en el perfil de tests y el
# oráculo de vim exige una versión exacta de nvim. La corre el CI.

package() {
  cd nota
  install -Dm755 target/release/nota -t "$pkgdir/usr/bin"
  install -Dm644 packaging/linux/nota.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/linux/nota.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 packaging/linux/io.github.alex_glez_felix.nota.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/nota"
}
