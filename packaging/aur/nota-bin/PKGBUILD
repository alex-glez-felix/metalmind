# Maintainer: Alejandro Gonzalez <alex.glez.felix at gmail dot com>

# Instala el binario del GitHub Release. Al publicar una versión, pkgver y las
# sumas se actualizan como dice docs/release.md.
pkgname=nota-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Editor de notas markdown con modo vim, nativo para Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/alex-glez-felix/nota'
license=('GPL-3.0-or-later')
# ttf-dejavu: nota no abre sin una monoespaciada de su lista (nota-ui/src/theme.rs).
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'ttf-dejavu' 'vulkan-icd-loader' 'wayland')
optdepends=('ttf-jetbrains-mono: la fuente monoespaciada preferida')
provides=('nota')
conflicts=('nota')
source_x86_64=("$url/releases/download/v$pkgver/nota-x86_64-unknown-linux-gnu.tar.xz")
source_aarch64=("$url/releases/download/v$pkgver/nota-aarch64-unknown-linux-gnu.tar.xz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "nota-$CARCH-unknown-linux-gnu"
  install -Dm755 nota -t "$pkgdir/usr/bin"
  install -Dm644 nota.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 nota.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 io.github.alex_glez_felix.nota.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/nota"
}
