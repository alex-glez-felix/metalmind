  <name>Metalmind</name>
  <summary>Editor de notas markdown con modo vim</summary>
  <description>
    <p>
      Metalmind es una app de notas nativa para Linux, escrita en Rust. Edita archivos
      markdown planos con un modo vim fiel, verificado contra Neovim.
    </p>
    <p>Prioriza el rendimiento: arranque rápido y scroll fluido aun con archivos grandes.</p>
  </description>
  <developer id="io.github.alex_glez_felix">
    <name>Alejandro Gonzalez</name>
  </developer>
  <launchable type="desktop-id">metalmind.desktop</launchable>
  <url type="homepage">https://github.com/alex-glez-felix/metalmind</url>
  <url type="bugtracker">https://github.com/alex-glez-felix/metalmind/issues</url>
  <url type="vcs-browser">https://github.com/alex-glez-felix/metalmind</url>
