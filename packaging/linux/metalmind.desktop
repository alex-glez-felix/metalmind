[Desktop Entry]
Type=Application
Name=Metalmind
GenericName=Editor de notas
Comment=Notas en markdown con modo vim
Exec=metalmind %f
Icon=metalmind
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/markdown;
Keywords=markdown;notas;vim;
StartupWMClass=metalmind
# Metalmind abre siempre un archivo: desde el menú, sin argumento, no haría nada.
# La entrada sirve para "Abrir con" en los .md.
NoDisplay=true
