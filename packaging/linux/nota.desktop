[Desktop Entry]
Type=Application
Name=nota
GenericName=Editor de notas
Comment=Notas en markdown con modo vim
Exec=nota %f
Icon=nota
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/markdown;
Keywords=markdown;notas;vim;
StartupWMClass=nota
# nota abre siempre un archivo: desde el menú, sin argumento, no haría nada.
# La entrada sirve para "Abrir con" en los .md.
NoDisplay=true
